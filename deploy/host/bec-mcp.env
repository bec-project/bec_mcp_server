# /etc/bec-mcp/bec-mcp.env: non-secret settings for bec-mcp.service. Secrets do not go here;
# the token and the Redis password live in /etc/bec-mcp/token and /etc/bec-mcp/mcp_ro.env.

# The beamline's BEC Redis.
BEC_REDIS_HOST=localhost
BEC_REDIS_PORT=6379

# Host header values the server accepts, comma-separated; 127.0.0.1 and localhost are always
# allowed. OpenCode in bob's sandbox reaches the server through sandbox-runtime's proxy as
# localhost4.localdomain4; a name without a port matches any port.
BEC_MCP_ALLOWED_HOSTS=localhost4.localdomain4
