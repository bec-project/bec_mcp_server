# /etc/bec-mcp/bec-mcp.env: non-secret settings for bec-mcp.service. Secrets do not go here;
# the token and the Redis password live in /etc/bec-mcp/token and /etc/bec-mcp/mcp_ro.env.

# The beamline's BEC Redis, the server's only network peer.
BEC_REDIS_HOST=localhost
BEC_REDIS_PORT=6379

# Host header values the server accepts, comma-separated. Agents in rootless podman containers
# reach the host as host.containers.internal; 127.0.0.1 and localhost are always allowed.
BEC_MCP_ALLOWED_HOSTS=host.containers.internal:*
